[gd_scene format=3]

[ext_resource type="Script" path="res://addons/game_base/ui/exit_confirmation.gd" id="1_script"]
[ext_resource type="FontFile" path="res://addons/game_base/fonts/Galmuri11.ttf" id="2_font"]

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
bg_color = Color(0.07, 0.09, 0.10, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
