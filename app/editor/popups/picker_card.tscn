[gd_scene format=3]

[ext_resource type="Script" path="res://app/editor/popups/picker_card.gd" id="1_script"]
[ext_resource type="Script" path="res://app/editor/popups/mini_preview.gd" id="2_preview"]

[node name="PickerCard" type="Button"]
custom_minimum_size = Vector2(150, 112)
size_flags_horizontal = 3
theme_type_variation = &"CardButton"
toggle_mode = true
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Preview" type="Control" parent="Margin/Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
script = ExtResource("2_preview")

[node name="Icon" type="TextureRect" parent="Margin/Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Sample" type="Label" parent="Margin/Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3
auto_translate_mode = 2
text = "Aa"
horizontal_alignment = 1
vertical_alignment = 1
clip_text = true

[node name="Name" type="Label" parent="Margin/Rows"]
unique_name_in_owner = true
layout_mode = 2
text = "Name"
horizontal_alignment = 1
text_overrun_behavior = 3
