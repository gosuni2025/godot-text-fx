[gd_scene format=3]

[ext_resource type="Script" path="res://app/editor/panels/list_item.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/icons/ui/move_up.png" id="2_up"]
[ext_resource type="Texture2D" path="res://assets/icons/ui/move_down.png" id="3_down"]
[ext_resource type="Texture2D" path="res://assets/icons/ui/remove.png" id="4_remove"]

[node name="ListItem" type="PanelContainer"]
size_flags_horizontal = 3
script = ExtResource("1_script")

[node name="Body" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Body"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Body/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SectionTitle"
text = "Item"

[node name="Up" type="Button" parent="Body/Header"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Move up"
icon = ExtResource("2_up")

[node name="Down" type="Button" parent="Body/Header"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Move down"
icon = ExtResource("3_down")

[node name="Remove" type="Button" parent="Body/Header"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Remove"
icon = ExtResource("4_remove")

[node name="Fields" type="VBoxContainer" parent="Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8
