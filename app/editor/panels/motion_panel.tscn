[gd_scene format=3]

[ext_resource type="Script" path="res://app/editor/panels/motion_panel.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://app/editor/panels/segment_section.tscn" id="2_seg"]
[ext_resource type="Texture2D" path="res://assets/icons/ui/add.png" id="3_add"]

[node name="MotionPanel" type="ScrollContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0
script = ExtResource("1_script")

[node name="Body" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Enter" parent="Body" instance=ExtResource("2_seg")]
unique_name_in_owner = true
layout_mode = 2

[node name="Hold" type="PanelContainer" parent="Body"]
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Body/Hold"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Body/Hold/Rows"]
layout_mode = 2
theme_type_variation = &"SectionTitle"
text = "Hold"

[node name="HoldFields" type="VBoxContainer" parent="Body/Hold/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Scroll" type="Button" parent="Body/Hold/Rows"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
alignment = 0
text = "Scroll the whole block upward (no pages)"

[node name="EffectsTitle" type="Label" parent="Body/Hold/Rows"]
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Hold effects (stacked in order)"

[node name="EmptyHold" type="Label" parent="Body/Hold/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "No hold effects."

[node name="Effects" type="VBoxContainer" parent="Body/Hold/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="AddHold" type="Button" parent="Body/Hold/Rows"]
unique_name_in_owner = true
layout_mode = 2
text = "Add hold effect"
icon = ExtResource("3_add")

[node name="Exit" parent="Body" instance=ExtResource("2_seg")]
unique_name_in_owner = true
layout_mode = 2
