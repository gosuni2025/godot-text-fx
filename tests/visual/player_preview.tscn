[sub_resource type="Shader" id="Shader_checker"]
code = "shader_type canvas_item;
uniform float cell = 24.0;
void fragment() {
	vec2 c = floor(FRAGCOORD.xy / cell);
	float k = mod(c.x + c.y, 2.0);
	COLOR = vec4(mix(vec3(0.36), vec3(0.52), k), 1.0);
}
"

